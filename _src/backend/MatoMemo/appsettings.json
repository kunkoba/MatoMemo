{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LittleTripMemoConnStr": "Host=localhost;  Port=5432;  Database=mato_memo;  Username=postgres;  Password=password;  Include Error Detail=true"
  },
  "MyAppSettings": {
    "TableStatsUpdateIntervalMinutes": 60, // テーブル統計情報の更新
    "ReactionCountUpdateIntervalMinutes": 60, // リアクション集計
    "GarbageCleanupIntervalMinutes": 1440, // 論理削除データのゴミ掃除
    "ClickAggregateIntervalMinutes": 1440, // クリック数の集計（ユーザ数の重複を減らすため長めにした方がいい）
    "UserSummaryUpdateIntervalMinutes": 180, // ユーザー活動情報の集計間隔
    "ReportStatsUpdateIntervalMinutes": 360, // 通報実績の集計間隔
    "AppInfoUpdateIntervalMinutes": 360, // アプリ情報の集計間隔
    "DailyMaintenanceTime": "02:00",
    "MaxTableNum": 2
  },
  "JwtSettings": {
    "_comment": "■定期的に変更した方がいいが、変更に関しては慎重に",
    "SecretKey": "jV9kP2mR5zW8nB4vX7tQ1aC6sD3fG0hJjV9kP2mR5zW8nB4vX7tQ1aC6sD3fG0hJ-2026-01-24",
    "Issuer": "LittleTripMemo",
    "Audience": "LittleTripMemo",
    "ExpireDays": 1440
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/error-.txt",
          "rollingInterval": "Day",
          "shared": true,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}

