{
  "_comment_rewrites": "onrenderへの偽装でSameSite対策",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matomemo.onrender.com/api/:path*"
    }
  ],
  "_comment_headers": "クリックジャッキング対策 X-Frame-Options",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}